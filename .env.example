# ---------- database ----------
# Development / demo (zero-install): embedded Postgres (PGlite) runs inside
# the app process, auto-creating the schema and seeding on first run.
# Data persists under .data/pglite.
DATABASE_URL=pglite://.data/pglite
#
# Production: point at a real PostgreSQL server (schema via `npm run db:push`,
# content via `npm run db:seed`):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db
#
# Optional: expose PGlite over a socket (for external tools):
#   npm run local:db   →   127.0.0.1:5432
# Set AUTO_SEED=0 to skip automatic seeding of an empty database.

# ---------- embedded AI model ----------
# The assistant runs a GGUF language model *inside this server* (llama.cpp).
# Nothing is sent to any external AI API.
#
# Path to the model file (default: .data/models/gemma-3-270m-q4_k_m.gguf,
# fetched by `npm run model:download`):
# AI_GGUF_PATH=.data/models/gemma-3-270m-q4_k_m.gguf
#
# Give `npm run model:download` a direct GGUF URL to swap models
# (e.g. an instruct-tuned Qwen2.5-0.5B for richer answers):
# AI_MODEL_URL=https://huggingface.co/<org>/<repo>/resolve/main/model.gguf
#
# Tuning (defaults are conservative for 2-core CPUs):
# AI_CONTEXT_SIZE=4096
# AI_MAX_TOKENS=220
# AI_THREADS=2
