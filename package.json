{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:init",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.json",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "model:download": "node scripts/download-model.mjs",
    "ai:warmup": "tsx scripts/ai-warmup.ts",
    "local:db": "node scripts/pg-server.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "^16.3.6",
    "node-llama-cpp": "^3.22.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
